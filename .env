# =============================================================
# ENVIRONMENT CONFIGURATION
# ⚠️  Never commit this file to version control
#     Add .env to your .gitignore
# =============================================================

# =============================================================
# AIRFLOW CORE
# =============================================================
AIRFLOW_UID=50000

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW__WEBSERVER__SECRET_KEY=

# =============================================================
# AIRFLOW ADMIN USER
# =============================================================
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=
AIRFLOW_ADMIN_EMAIL=

# =============================================================
# AIRFLOW METADATA DATABASE
# =============================================================
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=

# =============================================================
# DATA WAREHOUSE
# =============================================================
DATA_POSTGRES_USER=
DATA_POSTGRES_PASSWORD=
DATA_POSTGRES_DB=datawarehouse
DATA_POSTGRES_HOST=data-postgres
DATA_POSTGRES_PORT=5432

# =============================================================
# PGADMIN
# =============================================================
PGADMIN_DEFAULT_EMAIL=
PGADMIN_PASSWORD=

# =============================================================
# METABASE
# =============================================================
METABASE_USER=
METABASE_PASSWORD=
METABASE_DB=metabase

# =============================================================
# REDIS
# Generate with:
# python -c "import secrets; print(secrets.token_hex(32))"
# =============================================================
REDIS_PASSWORD=

# =============================================================
# CONNECTION STRINGS
# ⚠️  .env does not support variable interpolation
#     Paste actual values — do not use ${VAR} syntax here
#     Format: postgresql://USER:PASSWORD@data-postgres:5432/datawarehouse?options=-csearch_path=SCHEMA
# =============================================================
BRONZE_POSTGRES_CONN=postgresql://USER:PASSWORD@data-postgres:5432/datawarehouse?options=-csearch_path=bronze
SILVER_POSTGRES_CONN=postgresql://USER:PASSWORD@data-postgres:5432/datawarehouse?options=-csearch_path=silver
GOLD_POSTGRES_CONN=postgresql://USER:PASSWORD@data-postgres:5432/datawarehouse?options=-csearch_path=gold
